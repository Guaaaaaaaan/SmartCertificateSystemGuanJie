@using SmartCertificateSystem.Models
@{
    var role = Context.Session.GetString(SessionKeys.Role);
    var fullName = Context.Session.GetString(SessionKeys.FullName);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Certificate</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Smart Certificate</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Certificate" asp-action="Verify">Verify Certificate</a></li>
                        @if (role == UserRoles.Admin)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Students">Students</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Courses">Courses</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Certificates">Certificates</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Files">Files</a></li>
                        }
                        @if (role == UserRoles.Student)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Student" asp-action="Dashboard">My Records</a></li>
                        }
                        @if (role == UserRoles.Employer)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Employer" asp-action="Index">Employer</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(role))
                        {
                            <span class="text-muted small">@fullName (@role)</span>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-secondary btn-sm" type="submit">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger">@error</div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container small">
            Smart Certificate Verification & Student Records Management System
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
