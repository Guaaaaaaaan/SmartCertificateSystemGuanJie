@{
    ViewData["Title"] = "Home";
}

<section class="page-hero">
    <div class="page-kicker mb-2">Academic credential platform</div>
    <h1 class="display-6 fw-bold mb-3">Smart Certificate Verification</h1>
    <p class="page-lede">
        A student records and certificate verification system for academic certificates, transcripts, grades, GPA, and employer validation.
    </p>
    <div class="hero-actions">
        <a class="btn btn-primary" asp-controller="Certificate" asp-action="Verify">Verify Certificate</a>
        <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Login</a>
    </div>
</section>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card role-card">
            <div class="card-body">
                <div class="card-kicker">Student access</div>
                <h2 class="h5">Students</h2>
                <p class="text-muted">View certificates, transcripts, grades, and GPA.</p>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Student Login</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card role-card">
            <div class="card-body">
                <div class="card-kicker">Public validation</div>
                <h2 class="h5">Employers</h2>
                <p class="text-muted">Validate academic credentials using Certificate ID, name, and DOB.</p>
                <a class="btn btn-outline-success" asp-controller="Certificate" asp-action="Verify">Verify Certificate</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card role-card">
            <div class="card-body">
                <div class="card-kicker">Records office</div>
                <h2 class="h5">Administrators</h2>
                <p class="text-muted">Manage students, courses, certificates, transcripts, and files.</p>
                <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login">Admin Login</a>
            </div>
        </div>
    </div>
</div>

<div class="quick-note mt-4">
    <div class="card-kicker mb-1">Demo accounts</div>
    Demo accounts: <strong>admin@example.com / Admin123!</strong>,
    <strong>student@example.com / Student123!</strong>,
    <strong>employer@example.com / Employer123!</strong>
</div>
