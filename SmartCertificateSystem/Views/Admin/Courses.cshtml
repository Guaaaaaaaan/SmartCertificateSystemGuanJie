@model CourseManagementViewModel
@{
    ViewData["Title"] = "Courses";
}

<div class="page-title-row">
    <div>
        <div class="page-kicker mb-2">Curriculum</div>
        <h1 class="h3 page-heading">Course Management</h1>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <form asp-action="AddCourse" method="post" class="form-panel h-100">
            <h2 class="h5">Add Course</h2>
            <label asp-for="CourseForm.CourseName" class="form-label"></label>
            <input name="CourseName" class="form-control mb-2" />
            <label asp-for="CourseForm.Description" class="form-label"></label>
            <textarea name="Description" class="form-control mb-3"></textarea>
            <button class="btn btn-primary" type="submit">Add Course</button>
        </form>
    </div>
    <div class="col-lg-4">
        <form asp-action="AddModule" method="post" class="form-panel h-100">
            <h2 class="h5">Assign Module</h2>
            <select name="CourseId" class="form-select mb-2">
                @foreach (var course in Model.Courses)
                {
                    <option value="@course.CourseId">@course.CourseName</option>
                }
            </select>
            <input name="ModuleName" class="form-control mb-2" placeholder="Module name" />
            <input name="CreditValue" class="form-control mb-3" type="number" min="1" max="10" value="3" />
            <button class="btn btn-primary" type="submit">Assign Module</button>
        </form>
    </div>
    <div class="col-lg-4">
        <form asp-action="EnrollStudent" method="post" class="form-panel h-100">
            <h2 class="h5">Enroll Student</h2>
            <select name="CourseId" class="form-select mb-2">
                @foreach (var course in Model.Courses)
                {
                    <option value="@course.CourseId">@course.CourseName</option>
                }
            </select>
            <select name="StudentId" class="form-select mb-3">
                @foreach (var student in Model.Students)
                {
                    <option value="@student.UserId">@student.FullName</option>
                }
            </select>
            <button class="btn btn-primary" type="submit">Enroll</button>
        </form>
    </div>
</div>

@foreach (var course in Model.Courses)
{
    <div class="course-card mb-3">
            <form asp-action="UpdateCourse" method="post" class="row g-2 align-items-end mb-3">
                <input type="hidden" name="CourseId" value="@course.CourseId" />
                <div class="col-md-4">
                    <label class="form-label">Course Name</label>
                    <input name="CourseName" value="@course.CourseName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Description</label>
                    <input name="Description" value="@course.Description" class="form-control" />
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button class="btn btn-outline-primary w-100" type="submit">Save</button>
                </div>
            </form>
            <form asp-action="DeleteCourse" asp-route-id="@course.CourseId" method="post" class="mb-3">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete Course</button>
            </form>

            <div class="row">
                <div class="col-lg-7">
                    <h3 class="h6">Modules</h3>
                    @foreach (var module in course.Modules)
                    {
                        <form asp-action="UpdateModule" method="post" class="row g-2 align-items-center mb-2">
                            <input type="hidden" name="ModuleId" value="@module.ModuleId" />
                            <input type="hidden" name="CourseId" value="@course.CourseId" />
                            <div class="col-md-6">
                                <input name="ModuleName" value="@module.ModuleName" class="form-control form-control-sm" />
                            </div>
                            <div class="col-md-2">
                                <input name="CreditValue" value="@module.CreditValue" class="form-control form-control-sm" type="number" min="1" max="10" />
                            </div>
                            <div class="col-md-4 d-flex gap-2">
                                <button class="btn btn-sm btn-outline-primary" type="submit">Save</button>
                                <button class="btn btn-sm btn-outline-danger"
                                        type="submit"
                                        formaction="@Url.Action("DeleteModule", "Admin", new { id = module.ModuleId })">
                                    Delete
                                </button>
                            </div>
                        </form>
                    }
                </div>
                <div class="col-lg-5">
                    <h3 class="h6">Enrolled Students</h3>
                    <ul class="list-clean">
                    @foreach (var enrollment in course.Enrollments)
                    {
                        <li>@enrollment.Student?.FullName</li>
                    }
                    </ul>
                </div>
            </div>
    </div>
}
