@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="page-title-row">
    <div>
        <div class="page-kicker mb-2">Records office</div>
        <h1 class="h3 page-heading">Admin Dashboard</h1>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card metric-card">
            <div class="card-body">
                <div class="metric-label">Students</div>
                <div class="metric-value">@Model.StudentCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card metric-card--success">
            <div class="card-body">
                <div class="metric-label">Certificates</div>
                <div class="metric-value">@Model.CertificateCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card metric-card--accent">
            <div class="card-body">
                <div class="metric-label">Courses</div>
                <div class="metric-value">@Model.CourseCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card metric-card--dark">
            <div class="card-body">
                <div class="metric-label">Raw SQL Student Count</div>
                <div class="metric-value">@Model.RawSqlStudentCount</div>
            </div>
        </div>
    </div>
</div>

<div class="action-strip">
    <a class="btn btn-primary" asp-action="Students">Manage Students</a>
    <a class="btn btn-primary" asp-action="Courses">Manage Courses</a>
    <a class="btn btn-primary" asp-action="Certificates">Manage Certificates</a>
    <a class="btn btn-outline-primary" asp-action="Files">Upload Files</a>
</div>
