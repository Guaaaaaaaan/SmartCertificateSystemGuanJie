@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-shell">
    <div class="auth-card">
        <div class="page-kicker mb-2">Secure access</div>
        <h1 class="h3 mb-2">Login</h1>
        <p class="text-muted mb-4">Sign in as an administrator, student, or employer to continue.</p>
        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Login</button>
        </form>
    </div>
    <aside class="demo-panel">
        <div class="page-kicker mb-2">Demo accounts</div>
        <h2 class="h5 mb-3">Use these credentials</h2>
        <div class="demo-list small">
            <div class="demo-row"><strong>Admin</strong><br />admin@example.com / Admin123!</div>
            <div class="demo-row"><strong>Employer</strong><br />employer@example.com / Employer123!</div>
            <div class="demo-row"><strong>Student</strong><br />student@example.com / Student123!</div>
            <div class="demo-row"><strong>Student</strong><br />mei.chen@example.com / Student123!</div>
            <div class="demo-row"><strong>Student</strong><br />ravi.kumar@example.com / Student123!</div>
            <div class="demo-row"><strong>Student</strong><br />sophia.lim@example.com / Student123!</div>
            <div class="demo-row"><strong>Student</strong><br />nur.aisyah@example.com / Student123!</div>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
